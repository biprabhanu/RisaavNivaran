# Copy to .env (never commit .env). Everything is optional; the demo runs fully without any key.

# Optional: enables Claude drafting of notices / explanations / summaries. Unset = template mode.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Backend
PORT=8000
PLUMEPROOF_DB=backend/data/plumeproof.db
# FRONTEND_DIST=frontend/dist   # where FastAPI finds the built React app

# Frontend (dev only). Leave empty to use relative /api (Vite proxies it to :8000)
VITE_API_BASE_URL=

# Frontend map tiles (optional, build time). Empty = OpenStreetMap with a light-grey filter.
# CARTO Positron needs an API key now, e.g.:
# VITE_MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png?api_key=YOUR_KEY
VITE_MAP_TILE_URL=
